rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allowlist lives in Firestore config/access, shared with firestore.rules and the functions.
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in firestore.get(/databases/(default)/documents/config/access).data.emails;
    }
    function isOwner(uid) {
      return isAllowedUser() && request.auth.uid == uid;
    }

    // users/{uid}/episodes/{episodeId}/audio.<ext> | words.json | transcript.txt | aligned.json
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      // Cap uploads at 3 GiB, the largest video whose audio the transcription function can extract.
      allow create, update: if isOwner(uid) && request.resource.size < 3 * 1024 * 1024 * 1024;
    }
  }
}
