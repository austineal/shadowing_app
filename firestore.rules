rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only verified Google accounts listed in config/access (field `emails`, lowercase)
    // may read or write, and each only under their own uid. Anyone else can sign in
    // but gets no data access and cannot trigger paid transcription. storage.rules and
    // the functions read the same document. Clients can't read or write config/.
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in get(/databases/$(database)/documents/config/access).data.emails;
    }
    function isOwner(uid) {
      return isAllowedUser() && request.auth.uid == uid;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }
  }
}
